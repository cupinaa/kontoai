# Copy to .env and fill in. Never commit .env.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model name. gemini-3.6-flash is the current stable Flash model in the Gemini API docs.
# Alternatives: gemini-3.8-flash (newest), gemini-3.5-flash-lite (cheapest stable).
GEMINI_MODEL=gemini-3.6-flash

# Suggestions with confidence below this value are flagged for manual review.
REVIEW_THRESHOLD=0.75

# SQLite database with confirmed postings (per-client history).
KONTOAI_DB_PATH=kontoai.db
